# Copy to .env and fill in. .env is git-ignored; never commit it.
# Only the development scripts read it (probe, reset-bracket, smoke, sync-card,
# wiiload). The relay's own settings are made on its setup page.

# start.gg personal access token of a tournament admin
# (start.gg > Developer Settings > Personal Access Tokens).
STARTGG_TOKEN=

# The relay's Wii secret, from its settings page: sync-card writes it on SD
# cards as secret=, smoke sends it.
RELAY_SECRET=

# For scripts/probe.ts --resolve and --weekly: what the setup page would pick.
# Melee singles event whose name contains this, e.g. Melee Singles
EVENT_NAME=
# Stream name exactly as in the tournament's stream settings (empty = no stream)
STREAM_NAME=
# A numbered weekly's name without its number, e.g. "My Bar Weekly #".
WEEKLY_NAME_PREFIX=

# Only for scripts/reset-bracket.ts, which resets every set of this event on
# start.gg so a test bracket can be played again. Use your test event's id
# (scripts/probe.ts --tournament=<slug> lists event ids). Never a real event.
EVENT_ID=

# Development only: the folder holding "Slippi Dolphin.exe" (the Ishiiruka development
# build) and a stock Melee 1.02 image, for .claude/skills/dolphin-test/dolphin.ps1.
DOLPHIN_DIR=
MELEE_ISO=
