# Copy to .env and fill in. .env is git-ignored; never commit it.
# deploy/push.ps1 reads it to write the relay's config on the Pi.

# start.gg personal access token of a tournament admin
# (start.gg > Developer Settings > Personal Access Tokens).
STARTGG_TOKEN=

# Shared secret every Wii sends. 8-16 of A-Z a-z 0-9 - _.
# The same value goes on every SD card as secret= (deploy/sync-card.ps1 writes it).
RELAY_SECRET=

# Your event. TOURNAMENT is your start.gg short URL (start.gg/<this>), or a full
# slug "tournament/<slug>" for one fixed tournament.
TOURNAMENT=
# Melee singles event whose name contains this, e.g. Melee Singles
EVENT_NAME=
# Stream name exactly as in the tournament's stream settings
STREAM_NAME=
# Optional: station number of the stream Wii (default 1)
STREAM_STATION=
# Optional, default startgg. The best-of each set is played to:
#   startgg  as start.gg has it per set (an in-person event cannot vary this per round: all 5)
#   top8q    Bo3 until the top-8 qualifiers (Winners Quarter-Final and its losers-side
#            counterpart), Bo5 from there on
SET_FORMAT=
# Optional, for a numbered weekly whose short URL you move each week:
# the weekly's name without its number, e.g. "My Bar Weekly #".
# If the short URL has not been moved yet, the relay takes the nearest one.
WEEKLY_NAME_PREFIX=

# Optional: file names of the set archive (one zip of labelled replays per set,
# from each station's Slippi Beamer; /var/lib/lazyto/archive on the Pi).
# {fields}: tournament number event round round_short p1 p2 winner loser score
# date set_id; the game name also has game stage stage_name p1_char p2_char
# game_winner. "number" is the last number in the tournament's name, so
# "My Bar {number} - {round_short} - {p1} vs {p2}" names a set
# "My Bar 60 - WSF - Cody vs Zain".
ARCHIVE_SET_NAME=
ARCHIVE_GAME_NAME=

# Optional: a test tournament for push.ps1 -Test, as a full slug.
TEST_TOURNAMENT=

# Only for scripts/reset-bracket.ts, which resets every set of this event on
# start.gg so a test bracket can be played again. Use your test event's id
# (scripts/probe.ts --tournament=<slug> lists event ids). Never a real event.
EVENT_ID=

# Development only: the folder holding "Slippi Dolphin.exe" (the Ishiiruka development
# build) and a stock Melee 1.02 image, for .claude/skills/dolphin-test/dolphin.ps1.
DOLPHIN_DIR=
MELEE_ISO=
