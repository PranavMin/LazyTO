{
  "name": "lazyto-relay",
  "version": "0.9.0-beta.1",
  "license": "GPL-2.0-only",
  "private": true,
  "main": "dist/main.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "python tools/check_protocol.py",
    "test": "npm run check && tsc --noEmit && tsx --test \"test/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/main.ts",
    "sim": "tsx scripts/sim-wii.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prettier": "3.9.9",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
