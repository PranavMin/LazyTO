{
  // Production build (architecture.md): `npm run build` -> dist/.
  // Extends the type-check config; rootDir is the repo root because
  // generated/wire.ts sits beside src/ and is compiled in place, never
  // copied. So src/main.ts lands at dist/src/main.js, and the root main.ts
  // lands at dist/main.js, the path the systemd unit runs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["main.ts", "src", "generated"]
}
