# systemd unit for the LazyTO relay (architecture.md Deployment).
# Installed to /etc/systemd/system by deploy/install.sh. Node lives at
# /opt/node (a pinned official tarball), the compiled relay at
# /opt/lazyto/dist, its settings and logs in /var/lib/lazyto.

[Unit]
Description=LazyTO relay (Wii <-> start.gg)
Documentation=https://github.com/PranavMin/LazyTO/blob/main/docs/night-of.md
After=network-online.target
Wants=network-online.target
# Never give up on a crash. (A Pi that boots without Wi-Fi, before the
# clock is set, or before tonight's tournament is findable does not exit:
# the relay keeps its page up and tries again itself, app.ts.)
StartLimitIntervalSec=0

[Service]
Type=simple
User=relay
Group=relay
WorkingDirectory=/opt/lazyto
# Auto-update before every start (deploy/update.sh): fetch the relay bundle
# built from the newest main, verify it, check it accepts the relay's
# settings (/var/lib/lazyto/config.json), swap it in. The "+" runs it as root outside the sandbox below;
# it logs one line and lets the installed version start on any failure, so a
# Pi without internet starts as before. /etc/lazyto/no-auto-update disables it.
ExecStartPre=+/opt/lazyto/deploy/update.sh
ExecStart=/opt/node/bin/node /opt/lazyto/dist/main.js
# The relay exits non-zero only if its web server cannot start (port 29473
# taken) or it crashes; on-failure brings it back. Restarts wait 10 s,
# stretching over 5 steps to 2 min (RestartSteps/RestartMaxDelaySec,
# systemd >= 254: Raspberry Pi OS Trixie; an older systemd ignores the two
# keys and waits 10 s every time).
Restart=on-failure
RestartSec=10
RestartSteps=5
RestartMaxDelaySec=120
SyslogIdentifier=lazyto-relay
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
