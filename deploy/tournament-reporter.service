# systemd unit for the Tournament Reporter relay (docs/design.md section 10).
# Installed to /etc/systemd/system by deploy/install.sh. Node lives at
# /opt/node (a pinned official tarball), the compiled relay at
# /opt/tournament-reporter/dist, config at /etc/tournament-reporter.

[Unit]
Description=Tournament Reporter relay (Wii <-> start.gg)
Documentation=file:///opt/tournament-reporter/README.md
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=relay
Group=relay
WorkingDirectory=/opt/tournament-reporter
Environment=CONFIG=/etc/tournament-reporter/config.json
ExecStart=/opt/node/bin/node /opt/tournament-reporter/dist/main.js
# The relay exits non-zero on a bad config or an unreachable start.gg at
# startup (fail fast). on-failure brings it back when the network returns;
# a genuinely bad config shows up as a restart loop in `systemctl status`.
Restart=on-failure
RestartSec=5
SyslogIdentifier=tournament-reporter
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
