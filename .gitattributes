# Generated protocol sources are written with LF by tools/gen_protocol.py;
# keep them LF on every checkout so tools/check_protocol.py diffs cleanly.
generated/** text eol=lf
protocol.yaml text eol=lf
tools/*.py    text eol=lf
# Deployment files run on the Pi: keep them LF regardless of the checkout.
deploy/**     text eol=lf
# The kiosk's generated sources (relay_proto.h, texture and glyph tables) are written with LF.
kiosk/include/** text eol=lf
kiosk/src/**/*.inc text eol=lf
# Replay Reporter's conformance bundle: compared byte for byte (context.json,
# .slp, zips), so no checkout may rewrite a byte.
test/rr-conformance/** -text
