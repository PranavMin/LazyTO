{
  "name": "lazyto",
  "productName": "LazyTO",
  "description": "Runs a Melee tournament's start.gg reporting from the TO's laptop",
  "version": "0.0.0",
  "license": "GPL-2.0-only",
  "author": "LazyTO",
  "homepage": "https://github.com/PranavMin/LazyTO",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p beamers/tsconfig.json",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --publish never",
    "version-from-git": "node scripts/version-from-git.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "esptool-js": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/w3c-web-serial": "^1.0.8",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "productName": "LazyTO",
    "appId": "gg.lazyto.app",
    "asar": true,
    "afterPack": "scripts/mach-o-uuid.cjs",
    "files": [
      "dist/**/*",
      "beamers/*.html",
      "beamers/*.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/wii",
        "to": "wii"
      },
      {
        "from": "resources/firmware",
        "to": "firmware"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "mac": {
      "target": {
        "target": "dmg",
        "arch": "universal"
      },
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "12.0",
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "LazyTO tells your stations' beamers where it is and collects their replays."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "LazyTO-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "LazyTO-${version}-${arch}.${ext}"
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": null
  }
}
